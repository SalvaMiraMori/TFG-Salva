<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="10dp"
    android:focusable="true"
    android:clickable="true"
    android:id="@+id/matchCard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="fill_parent"
        android:orientation="horizontal"
        android:weightSum="3"
        tools:ignore="MissingConstraints">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            tools:ignore="Suspicious0dp">

            <ImageView
                android:id="@+id/logoTeam1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:srcCompat="@mipmap/league_logo_foreground" />

            <TextView
                android:id="@+id/nameTeam1Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Name Team1"
                android:textAlignment="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:weightSum="5"
            tools:ignore="Suspicious0dp">

            <TextView
                android:id="@+id/playingStartingTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Playing/Starting time"
                android:textAlignment="center" />

            <ImageView
                android:id="@+id/vsImageView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                app:srcCompat="@mipmap/vs_image_foreground" />

            <TextView
                android:id="@+id/gameNumberAndStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Game X: Match status"
                android:textAlignment="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            tools:ignore="Suspicious0dp">

            <ImageView
                android:id="@+id/logoTeam2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:srcCompat="@mipmap/league_logo_foreground" />

            <TextView
                android:id="@+id/nameTeam2Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Name Team2"
                android:textAlignment="center" />

            <com.like.LikeButton
                android:id="@+id/subscriptionButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:anim_scale_factor="6"
                app:icon_size="10dp"
                app:icon_type="heart" />
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>